# Gemini API Key (Get a free one from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Facebook Scraper Settings
FB_PAGE_URL=https://www.facebook.com/profile.php?id=61565051884389
FB_KEYWORD=館內活動表

# Linktree Settings
LINKTREE_TARGET_TITLE_KEYWORD=館內活動表

# Review Settings
REQUIRE_REVIEW=true

# interactive: show plan and wait for approval; plan: save plan only;
# auto: apply without stdin. Scheduled runs should use plan until verified.
RUN_MODE=interactive

# Optional manual rerun target, 1-12. Empty means next calendar month.
TARGET_MONTH=
# Optional year for a manual target month. Empty means the current year.
TARGET_YEAR=

# Recovery only: retry a post even if an older run marked it processed
RETRY_PROCESSED_POSTS=false
